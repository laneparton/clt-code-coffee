---
const { compact = false, class: className = '' } = Astro.props;
---
{compact ? (
  <span class={className}>
    <img class="hidden h-auto w-full light:block" src="/brand/03-compact-mark-light.svg" width="476" height="476" alt="Charlotte Code & Coffee" />
    <img class="block h-auto w-full light:hidden" src="/brand/03-compact-mark-dark.svg" width="476" height="476" alt="Charlotte Code & Coffee" />
  </span>
) : (
  <span class:list={['flex items-center gap-3 text-text font-mono max-[700px]:gap-2', className]}>
    <svg class="size-[43px] flex-none max-[700px]:h-[38px] max-[700px]:w-[34px]" viewBox="0 0 106 94" aria-hidden="true" fill="none" stroke-linecap="round" stroke-linejoin="round">
      <path d="M13 30 H72 V64 Q72 83 54 83 H31 Q13 83 13 64 Z M72 40 H82 Q101 40 94 59 Q89 69 74 67" stroke="currentColor" stroke-width="5" />
      <path d="M28 20 Q17 11 29 3 M50 20 Q39 11 51 3" stroke="var(--color-purple)" stroke-width="5" />
      <path d="M30 52 L39 60 L30 68 M49 68 H62" stroke="var(--color-pink)" stroke-width="4" />
    </svg>
    <span class="flex flex-col gap-[5px] leading-[1.1]"><span class="text-[14px] tracking-[1.5px] uppercase text-muted max-[700px]:text-[13px] max-[700px]:tracking-[1px]">Charlotte</span><span class="text-[21px] font-bold whitespace-nowrap tracking-[-.6px] max-[700px]:text-[17px]"><span class="text-pink">Code</span> <span class="text-purple">&amp;</span> Coffee</span></span>
  </span>
)}

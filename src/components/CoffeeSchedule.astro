---
import CoffeeEntry from './CoffeeEntry.astro';
import { scheduleEntries } from '../data/schedule.js';
const { config } = Astro.props;
const entries = scheduleEntries(config);
const now = new Date();
const active = entries.filter(entry => entry.end > now);
const featured = active.find(entry => entry.kind === 'coffee');
const remaining = active.filter(entry => entry !== featured);
const signature = active.map(entry => entry.date).join(',');
---
<div class="coffee-schedule" data-signature={signature}>
  <section class="grid grid-cols-[1.15fr_1fr] gap-x-12 gap-y-8 pt-12 pb-9 max-[950px]:grid-cols-1 max-[950px]:gap-6 max-[950px]:pt-8" aria-labelledby="hero-title">
    <div class="min-w-0">
      <slot />
      <pre class="mt-6 mb-0 w-fit max-w-full overflow-x-auto rounded-md bg-panel px-5 py-4 font-mono text-[16px] leading-[1.5] text-cyan" role="group" aria-label="Signature command"><code class="font-[inherit]"><span class="mr-2 text-pink" aria-hidden="true">&gt;</span> coffee <span class="text-purple">--with</span> engineers</code></pre>
    </div>
    <section class="min-w-0 scroll-mt-6 rounded-lg border border-line border-t-3 border-t-purple bg-panel p-7 max-[600px]:p-[22px]" id="next-coffee" aria-labelledby="coffee-title">
      <h2 id="coffee-title" class="mt-0 mb-[22px] font-mono text-[15px] leading-[normal] font-semibold text-cyan max-[600px]:mb-4">Next coffee</h2>
      <div class="featured-entry group/featured">{featured && <CoffeeEntry entry={featured} timezone={config.timezone} />}</div>
      <p class="schedule-empty m-0 text-muted" hidden={!!featured}>Next date to be announced.</p>
      <noscript><p class="mt-5 mb-0 text-[14px] text-muted">Schedule as of {now.toLocaleDateString('en-US', { timeZone: config.timezone, month: 'long', day: 'numeric', year: 'numeric' })}.</p></noscript>
    </section>
  </section>
  <section class="schedule-lineup border-t border-line pt-9 pb-12 max-[700px]:pb-9" aria-labelledby="lineup-title" hidden={remaining.length === 0}>
    <div class="mb-6 font-mono text-[14px] leading-[normal] font-semibold tracking-[1px] text-cyan"><span class="mr-2.5 text-purple" aria-hidden="true">01 /</span> THE LINEUP</div>
    <h2 id="lineup-title" class="mt-0 mb-6 text-[26px] leading-[1.3] font-bold tracking-[-.7px] max-[600px]:text-[24px]">More Fridays, more shop talk.</h2>
    <ul class="event-list group/lineup m-0 list-none p-0">{remaining.map(entry => <li class="border-t border-line"><CoffeeEntry entry={entry} timezone={config.timezone} /></li>)}</ul>
  </section>
  {entries.map(entry => <template data-date={entry.date} data-kind={entry.kind} data-end={entry.end.toISOString()}><CoffeeEntry entry={entry} timezone={config.timezone} /></template>)}
</div>

<script>
  const root = document.querySelector<HTMLElement>('.coffee-schedule');
  if (root) {
    const templates = [...root.querySelectorAll<HTMLTemplateElement>('template[data-end]')];
    const featuredContainer = root.querySelector<HTMLElement>('.featured-entry')!;
    const list = root.querySelector<HTMLUListElement>('.event-list')!;
    const lineup = root.querySelector<HTMLElement>('.schedule-lineup')!;
    const empty = root.querySelector<HTMLElement>('.schedule-empty')!;
    let timer: ReturnType<typeof setTimeout>;
    const clone = (template: HTMLTemplateElement) => template.content.firstElementChild!.cloneNode(true) as HTMLElement;
    const sync = () => {
      clearTimeout(timer);
      const now = Date.now();
      const active = templates.filter(template => Date.parse(template.dataset.end!) > now);
      const signature = active.map(template => template.dataset.date).join(',');
      if (signature !== root.dataset.signature) {
        const featured = active.find(template => template.dataset.kind === 'coffee');
        const featuredNode = featured && clone(featured);
        featuredContainer.replaceChildren(...(featuredNode ? [featuredNode] : []));
        empty.hidden = !!featured;
        list.replaceChildren(...active.filter(template => template !== featured).map(template => {
          const item = document.createElement('li');
          item.className = 'border-t border-line';
          const entry = clone(template);
          item.append(entry);
          return item;
        }));
        lineup.hidden = list.children.length === 0;
        root.dataset.signature = signature;
      }
      if (active.length) {
        const nextExpiry = Math.min(...active.map(template => Date.parse(template.dataset.end!)));
        timer = setTimeout(sync, Math.min(nextExpiry - now, 2147483647));
      }
    };
    sync();
    window.addEventListener('focus', sync);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) sync(); });
  }
</script>

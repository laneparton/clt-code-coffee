---
import CoffeeEntry from './CoffeeEntry.astro';
import { scheduleEntries } from '../data/schedule.js';
const { config } = Astro.props;
const entries = scheduleEntries(config);
const now = new Date();
const active = entries.filter(entry => entry.end > now);
const featured = active.find(entry => entry.kind === 'coffee');
const remaining = active.filter(entry => entry !== featured);
const signature = active.map(entry => entry.date).join(',');
---
<div class="coffee-schedule" data-signature={signature}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <slot />
      <pre class="signature" role="group" aria-label="Signature command"><code><span aria-hidden="true">&gt;</span> coffee <span class="purple">--with</span> engineers</code></pre>
    </div>
    <section class="next-coffee" id="next-coffee" aria-labelledby="coffee-title">
      <h2 id="coffee-title">Next coffee</h2>
      <div class="featured-entry">{featured && <CoffeeEntry entry={featured} timezone={config.timezone} />}</div>
      <p class="schedule-empty" hidden={!!featured}>Next date to be announced.</p>
      <noscript><p class="schedule-as-of">Schedule as of {now.toLocaleDateString('en-US', { timeZone: config.timezone, month: 'long', day: 'numeric', year: 'numeric' })}.</p></noscript>
    </section>
  </section>
  <section class="schedule-lineup" aria-labelledby="lineup-title" hidden={remaining.length === 0}>
    <div class="section-label"><span aria-hidden="true">01 /</span> THE LINEUP</div>
    <h2 id="lineup-title">More Fridays, more shop talk.</h2>
    <ul class="event-list">{remaining.map(entry => <li><CoffeeEntry entry={entry} timezone={config.timezone} /></li>)}</ul>
  </section>
  {entries.map(entry => <template data-date={entry.date} data-kind={entry.kind} data-end={entry.end.toISOString()}><CoffeeEntry entry={entry} timezone={config.timezone} /></template>)}
</div>

<script>
  const root = document.querySelector<HTMLElement>('.coffee-schedule');
  if (root) {
    const templates = [...root.querySelectorAll<HTMLTemplateElement>('template[data-end]')];
    const featuredContainer = root.querySelector<HTMLElement>('.featured-entry')!;
    const list = root.querySelector<HTMLUListElement>('.event-list')!;
    const lineup = root.querySelector<HTMLElement>('.schedule-lineup')!;
    const empty = root.querySelector<HTMLElement>('.schedule-empty')!;
    let timer: ReturnType<typeof setTimeout>;
    const clone = (template: HTMLTemplateElement) => template.content.firstElementChild!.cloneNode(true) as HTMLElement;
    const sync = () => {
      clearTimeout(timer);
      const now = Date.now();
      const active = templates.filter(template => Date.parse(template.dataset.end!) > now);
      const signature = active.map(template => template.dataset.date).join(',');
      if (signature !== root.dataset.signature) {
        const featured = active.find(template => template.dataset.kind === 'coffee');
        const featuredNode = featured && clone(featured);
        featuredContainer.replaceChildren(...(featuredNode ? [featuredNode] : []));
        empty.hidden = !!featured;
        list.replaceChildren(...active.filter(template => template !== featured).map(template => {
          const item = document.createElement('li');
          const entry = clone(template);
          item.append(entry);
          return item;
        }));
        lineup.hidden = list.children.length === 0;
        root.dataset.signature = signature;
      }
      if (active.length) {
        const nextExpiry = Math.min(...active.map(template => Date.parse(template.dataset.end!)));
        timer = setTimeout(sync, Math.min(nextExpiry - now, 2147483647));
      }
    };
    sync();
    window.addEventListener('focus', sync);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) sync(); });
  }
</script>

<style is:global>
  .coffee-schedule .hero { display: grid; grid-template-columns: 1.15fr 1fr; gap: 32px 48px; padding: 48px 0 36px; }
  .hero-copy { min-width: 0; }
  .coffee-schedule .next-coffee { min-width: 0; background: var(--panel); border: 1px solid var(--line); border-top: 3px solid var(--purple); border-radius: 8px; padding: 28px; scroll-margin-top: 24px; }
  .next-coffee h2 { color: var(--cyan); font: 600 15px var(--mono); margin-bottom: 22px; }
  .featured-entry .schedule-entry { display: grid; gap: 20px; }
  .event-when time { font-size: 24px; font-weight: 700; line-height: 1.3; }
  .event-time { color: var(--purple); font: 18px/1.5 var(--mono); margin: 6px 0 0; }
  .event-place h3 { font-size: 21px; line-height: 1.4; margin: 0 0 6px; }
  .event-address { color: var(--muted); font-size: 17px; line-height: 1.5; margin: 0 0 20px; }
  .event-map { gap: 20px; font-size: 15px; }
  .schedule-empty { margin: 0; color: var(--muted); }
  .schedule-as-of { margin: 20px 0 0; font-size: 14px; color: var(--muted); }
  .signature { width: fit-content; max-width: 100%; margin: 24px 0 0; padding: 16px 20px; border-radius: 6px; background: var(--panel); font: 16px/1.5 var(--mono); color: var(--cyan); overflow-x: auto; }
  .signature code { font: inherit; }
  .signature code > span:first-child { color: var(--pink); margin-right: 8px; }
  .schedule-lineup { border-top: 1px solid var(--line); }
  .schedule-lineup h2 { font-size: 26px; margin-bottom: 24px; }
  .coffee-schedule .event-list { list-style: none; padding: 0; margin: 0; }
  .event-list > li { border-top: 1px solid var(--line); }
  .event-list .schedule-entry { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; align-items: center; padding: 20px 0; }
  .event-list .event-when { display: grid; grid-template-columns: 220px auto; align-items: baseline; gap: 24px; }
  .event-list .event-when time { font: 600 18px/1.5 var(--mono); color: var(--pink); }
  .event-list .event-time { font-size: 16px; margin: 0; white-space: nowrap; }
  .event-list .event-place h3 { font-size: 17px; margin: 0; }
  .event-list .event-address, .event-list .event-map { display: none; }
  .event-list .break-entry .event-when time, .break-note { color: var(--muted); }
  .break-note h3 { font-size: 17px; margin: 0 0 4px; }
  .break-note p { font-size: 16px; line-height: 1.5; margin: 0; }
  @media(max-width:950px) {
    .coffee-schedule .hero { grid-template-columns: 1fr; gap: 24px; padding-top: 32px; }
    .event-list .event-when { display: flex; flex-direction: column; align-items: flex-start; gap: 4px; }
  }
  @media(max-width:600px) {
    .coffee-schedule .next-coffee { padding: 22px; }
    .next-coffee h2 { margin-bottom: 16px; }
    .featured-entry .schedule-entry { gap: 16px; }
    .event-when time { font-size: 22px; }
    .event-place h3 { font-size: 20px; }
    .event-list .schedule-entry { grid-template-columns: 1fr; gap: 6px; padding: 16px 0; }
    .event-list .event-when { flex-direction: row; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
    .event-list .event-when time { font-size: 16px; }
    .event-list .event-time { font-size: 15px; }
    .schedule-lineup h2 { font-size: 24px; }
  }
</style>

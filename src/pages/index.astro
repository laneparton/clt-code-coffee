---
import '../styles/global.css';
import Brand from '../components/Brand.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import CoffeeSchedule from '../components/CoffeeSchedule.astro';
import { meetup } from '../data/meetup.js';
import { safeUrl } from '../data/schedule.js';

const links = meetup.communityLinks.map(link => ({ ...link, url: safeUrl(link.url) }));
---
<!doctype html>
<html lang="en" class="scroll-smooth scroll-pt-8 motion-reduce:scroll-auto">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="The Friday Commit: a casual coffee meetup for working software engineers in Charlotte. No talks. No pitches. Just shop talk." />
    <meta name="theme-color" content="#282A36" />
    <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
    <title>Charlotte Code & Coffee | The Friday Commit</title>
    <script is:inline>
      // Apply a saved preference before painting; otherwise CSS follows the system.
      try {
        const theme = localStorage.getItem('coffee-theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body class="m-0 bg-bg font-sans text-[18px] leading-[1.65] text-text">
    <a class="absolute left-3 -top-[100px] z-2 bg-panel p-3 focus:top-3" href="#main">Skip to content</a>
    <div class="mx-auto max-w-[1120px] px-12 max-[700px]:px-[22px]">
      <header class="flex items-center justify-between gap-6 border-b border-line py-6 max-[700px]:gap-4 max-[700px]:py-[18px] max-[600px]:grid max-[600px]:grid-cols-[1fr_auto] max-[600px]:gap-y-[18px]">
        <a class="block no-underline max-[600px]:col-start-1 max-[600px]:row-start-1" href="#" aria-label="Charlotte Code & Coffee home"><Brand /></a>
        <div class="flex items-center gap-6 max-[700px]:gap-4 max-[600px]:contents"><nav class="font-mono text-[15px] leading-[normal] whitespace-nowrap max-[600px]:col-start-1 max-[600px]:row-start-2" aria-label="Main navigation"><a class="no-underline" href="#next-coffee">Next coffee <span class="ml-2 text-pink" aria-hidden="true">↗</span></a></nav><ThemeToggle /></div>
      </header>
      <main id="main">
        <CoffeeSchedule config={meetup}>
          <h1 id="hero-title" class="mt-0 mb-[22px] font-mono text-[clamp(48px,5vw,68px)] leading-[1.13] font-bold tracking-[-3px] max-[700px]:text-[48px] max-[700px]:tracking-[-2px] max-[370px]:text-[42px]"><span class="block text-[.53em] leading-none font-normal tracking-[-2px]">The</span><span class="block"><span class="text-pink">Friday</span> Commit<span class="text-purple" aria-hidden="true">_</span></span></h1>
          <p class="mt-7 mb-3.5 max-w-[640px] text-[21px] leading-[1.55] text-muted max-[700px]:mt-5 max-[700px]:mb-3 max-[700px]:text-[19px]">Good coffee.<br />Conversations worth closing your laptop for.</p>
          <p class="m-0 text-[20px] font-bold max-[700px]:text-[18px]">No talks. No pitches. Just shop talk.</p>
        </CoffeeSchedule>

        <section class="border-t border-line pt-9 pb-12 max-[700px]:pb-9" aria-labelledby="about-title">
          <div class="mb-6 font-mono text-[14px] leading-[normal] font-semibold tracking-[1px] text-cyan"><span class="mr-2.5 text-purple" aria-hidden="true">02 /</span> THE IDEA</div>
          <div class="grid grid-cols-[1fr_1.15fr] gap-16 max-[700px]:grid-cols-1 max-[700px]:gap-6 [&_p]:text-muted"><h2 id="about-title" class="mt-0 mb-5 text-[32px] leading-[1.3] font-bold tracking-[-.7px] max-[700px]:text-[30px]">Good coffee.<br />A technical rabbit hole.<br /><span class="text-purple">Familiar faces.</span></h2><div><p>Code, architecture, tools, AI, engineering tradeoffs. Whatever you're building, debugging, or reading is fair game.</p><p>Casual conversation over coffee. No slides to prepare or introductions to rehearse.</p><p>Working engineers, platform folks, and hands-on engineering leads are welcome. Any stack, any employer. You don't need to be senior to join the conversation.</p></div></div>
        </section>

        <section class="border-t border-line pt-9 pb-12 max-[700px]:pb-9" aria-labelledby="find-title">
          <div class="mb-6 font-mono text-[14px] leading-[normal] font-semibold tracking-[1px] text-cyan"><span class="mr-2.5 text-purple" aria-hidden="true">03 /</span> FIND YOUR PEOPLE</div>
          <div class="grid grid-cols-[1fr_1.15fr] items-center gap-16 max-[700px]:grid-cols-1 max-[700px]:gap-6 [&_p]:text-muted"><Brand compact class="mx-auto block w-[240px] max-[700px]:mx-0 max-[700px]:mb-3 max-[700px]:w-[190px]" /><div><h2 id="find-title" class="mt-0 mb-5 text-[34px] leading-[1.3] font-bold tracking-[-.7px] max-[700px]:text-[30px]">Look for the mug<br />with a prompt.</h2><p>Look for this mark on a laptop sticker or a small tabletop sign. Say hello and join the table.</p><p>Bring a laptop if you like. Or just bring yourself and order your usual.</p>{links.length > 0 && <nav class="flex flex-wrap gap-5 font-mono [&_a]:underline text-[16px] leading-[normal]" aria-label="Community links">{links.map(link => <a href={link.url}>{link.label} <span aria-hidden="true">↗</span></a>)}</nav>}</div></div>
        </section>

        <section class="border-t border-line pt-9 pb-12 max-[700px]:pb-9" aria-labelledby="faq-title"><div class="mb-6 font-mono text-[14px] leading-[normal] font-semibold tracking-[1px] text-cyan"><span class="mr-2.5 text-purple" aria-hidden="true">04 /</span> A FEW THINGS</div><h2 id="faq-title" class="sr-only">Common questions</h2>
          <details class="group border-b border-line last:border-b-0"><summary class="flex cursor-pointer list-none justify-between gap-5 py-[22px] text-[18px] [&::-webkit-details-marker]:hidden">Do I need to RSVP?<span class="font-mono text-[22px] leading-[normal] text-purple group-open:rotate-45" aria-hidden="true">+</span></summary><p class="max-w-[680px] pb-2.5 text-[17px] text-muted">No RSVP needed. Just drop by and join the table.</p></details>
          <details class="group border-b border-line last:border-b-0"><summary class="flex cursor-pointer list-none justify-between gap-5 py-[22px] text-[18px] [&::-webkit-details-marker]:hidden">Do I have to present something?<span class="font-mono text-[22px] leading-[normal] text-purple group-open:rotate-45" aria-hidden="true">+</span></summary><p class="max-w-[680px] pb-2.5 text-[17px] text-muted">No. There are no talks, demos, or agenda. Just conversation over coffee.</p></details>
          <details class="group border-b border-line last:border-b-0"><summary class="flex cursor-pointer list-none justify-between gap-5 py-[22px] text-[18px] [&::-webkit-details-marker]:hidden">I'm early in my career. Can I come?<span class="font-mono text-[22px] leading-[normal] text-purple group-open:rotate-45" aria-hidden="true">+</span></summary><p class="max-w-[680px] pb-2.5 text-[17px] text-muted">Yes. This is for people who build software professionally, at any level. It's peer conversation rather than a class or career coaching session.</p></details>
        </section>
      </main>
      <footer class="flex flex-wrap justify-between gap-6 border-t border-line pt-7 pb-9 font-mono text-[14px] leading-[1.6] text-muted max-[700px]:flex-col max-[700px]:gap-5">
        <div><span>Charlotte Code & Coffee</span><p class="mt-2 mb-0">Good coffee. Good engineering conversations.</p></div>
        <p class="m-0 [&_a]:text-pink [&_a]:underline">Organized by <a href="https://laneparton.com/">Lane Parton</a> · Charlotte, NC</p>
      </footer>
    </div>
  </body>
</html>

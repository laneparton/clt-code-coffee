---
import Brand from '../components/Brand.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import CoffeeSchedule from '../components/CoffeeSchedule.astro';
import { meetup } from '../data/meetup.js';
import { safeUrl } from '../data/schedule.js';

const links = meetup.communityLinks.map(link => ({ ...link, url: safeUrl(link.url) }));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="The Friday Commit: a casual coffee meetup for working software engineers in Charlotte. No talks. No pitches. Just shop talk." />
    <meta name="theme-color" content="#282A36" />
    <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
    <title>Charlotte Code & Coffee | The Friday Commit</title>
    <script is:inline>
      // Apply a saved preference before painting; otherwise CSS follows the system.
      try {
        const theme = localStorage.getItem('coffee-theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="page">
      <header>
        <a class="brand-link" href="#" aria-label="Charlotte Code & Coffee home"><Brand class="wordmark" /></a>
        <div class="header-actions"><nav aria-label="Main navigation"><a href="#next-coffee">Next coffee <span aria-hidden="true">↗</span></a></nav><ThemeToggle /></div>
      </header>
      <main id="main">
        <CoffeeSchedule config={meetup}>
          <h1 id="hero-title"><span class="the">The</span><span class="heading-line"><span class="pink">Friday</span> Commit<span class="cursor" aria-hidden="true">_</span></span></h1>
          <p class="intro">Good coffee.<br />Conversations worth closing your laptop for.</p>
          <p class="attitude">No talks. No pitches. Just shop talk.</p>
        </CoffeeSchedule>

        <section class="about" aria-labelledby="about-title">
          <div class="section-label"><span aria-hidden="true">02 /</span> THE IDEA</div>
          <div class="about-grid"><h2 id="about-title">Good coffee.<br />A technical rabbit hole.<br /><span class="purple">Familiar faces.</span></h2><div><p>Code, architecture, tools, AI, engineering tradeoffs. Whatever you're building, debugging, or reading is fair game.</p><p>Casual conversation over coffee. No slides to prepare or introductions to rehearse.</p><p>Working engineers, platform folks, and hands-on engineering leads are welcome. Any stack, any employer. You don't need to be senior to join the conversation.</p></div></div>
        </section>

        <section class="find" aria-labelledby="find-title">
          <div class="section-label"><span aria-hidden="true">03 /</span> FIND YOUR PEOPLE</div>
          <div class="find-grid"><Brand compact class="sticker" /><div><h2 id="find-title">Look for the mug<br />with a prompt.</h2><p>Look for this mark on a laptop sticker or a small tabletop sign. Say hello and join the table.</p><p>Bring a laptop if you like. Or just bring yourself and order your usual.</p>{links.length > 0 && <nav class="community" aria-label="Community links">{links.map(link => <a href={link.url}>{link.label} <span aria-hidden="true">↗</span></a>)}</nav>}</div></div>
        </section>

        <section class="faq" aria-labelledby="faq-title"><div class="section-label"><span aria-hidden="true">04 /</span> A FEW THINGS</div><h2 id="faq-title" class="sr-only">Common questions</h2>
          <details><summary>Do I need to RSVP?<span aria-hidden="true">+</span></summary><p>No RSVP needed. Just drop by and join the table.</p></details>
          <details><summary>Do I have to present something?<span aria-hidden="true">+</span></summary><p>No. There are no talks, demos, or agenda. Just conversation over coffee.</p></details>
          <details><summary>I'm early in my career. Can I come?<span aria-hidden="true">+</span></summary><p>Yes. This is for people who build software professionally, at any level. It's peer conversation rather than a class or career coaching session.</p></details>
        </section>
      </main>
      <footer>
        <div><span>Charlotte Code & Coffee</span><p class="footer-tagline">Good coffee. Good engineering conversations.</p></div>
        <p class="organizer">Organized by <a href="https://laneparton.com/">Lane Parton</a> · Charlotte, NC</p>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --bg: light-dark(#faf9f6, #282a36);
    --panel: light-dark(#f3f0fa, #343746);
    --text: light-dark(#282a36, #f8f8f2);
    --muted: light-dark(#57566c, #cecddb);
    --pink: light-dark(#ad216f, #ff79c6);
    --purple: light-dark(#7545b9, #bd93f9);
    --cyan: light-dark(#08748d, #8be9fd);
    --line: light-dark(#c8beda, #44475a);
    --button-text: light-dark(#fff, #282a36);
    --mono: ui-monospace, 'SFMono-Regular', Menlo, Consolas, 'Liberation Mono', monospace;
  }
  :root[data-theme=light] { color-scheme: light; }
  :root[data-theme=dark] { color-scheme: dark; }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 2rem; }
  body { margin: 0; background: var(--bg); color: var(--text); font-family: Arial, Helvetica, sans-serif; font-size: 18px; line-height: 1.65; }
  a { color: inherit; text-underline-offset: 5px; }
  a:hover { color: var(--pink); }
  a:focus-visible, summary:focus-visible { outline: 3px solid var(--cyan); outline-offset: 6px; }
  button, a, summary { -webkit-tap-highlight-color: transparent; }
  [hidden] { display: none !important; }
  .page { max-width: 1120px; padding: 0 48px; margin: auto; }
  header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--line); padding: 24px 0; gap: 24px; }
  .brand-link { display: block; text-decoration: none; }
  .header-actions { display: flex; align-items: center; gap: 24px; }
  header nav { font: 15px var(--mono); white-space: nowrap; }
  header nav a { text-decoration: none; }
  header nav span { color: var(--pink); margin-left: 8px; }
  .section-label { font: 600 14px var(--mono); letter-spacing: 1px; color: var(--cyan); margin-bottom: 24px; }
  .section-label span { color: var(--purple); margin-right: 10px; }
  h1 { font: 700 clamp(48px, 5vw, 68px)/1.13 var(--mono); letter-spacing: -3px; margin: 0 0 22px; }
  .the { display: block; font-size: .53em; line-height: 1; font-weight: 400; letter-spacing: -2px; margin-bottom: 0; }
  .heading-line { display: block; }
  .pink { color: var(--pink); }
  .purple, .cursor { color: var(--purple); }
  .intro { font-size: 21px; line-height: 1.55; max-width: 640px; color: var(--muted); margin: 28px 0 14px; }
  .attitude { font-weight: 700; font-size: 20px; margin: 0; }
  .button { display: inline-flex; align-items: center; gap: 28px; padding: 15px 20px; background: var(--purple); color: var(--button-text); border-radius: 5px; text-decoration: none; font: 700 16px var(--mono); }
  .button:hover { background: var(--pink); color: var(--button-text); }
  section:not(.hero) { padding: 36px 0 48px; }
  h2 { font-size: 34px; line-height: 1.3; letter-spacing: -.7px; margin: 0 0 20px; }
  h3 { font-size: 23px; line-height: 1.4; margin: 0 0 12px; }
  p { margin: 0 0 18px; }
  .about-grid { display: grid; grid-template-columns: 1fr 1.15fr; gap: 64px; }
  .about-grid h2 { font-size: 32px; }
  .about-grid p, .find p { color: var(--muted); }
  .about, .find, .faq { border-top: 1px solid var(--line); }
  .find-grid { display: grid; grid-template-columns: 1fr 1.15fr; align-items: center; gap: 64px; }
  .sticker { display: block; width: 240px; margin: 0 auto; }
  .sticker img { width: 100%; height: auto; display: block; }
  .community { display: flex; gap: 20px; flex-wrap: wrap; font: 16px var(--mono); }
  details { border-bottom: 1px solid var(--line); }
  .faq details:last-child { border-bottom: 0; }
  summary { display: flex; justify-content: space-between; gap: 20px; padding: 22px 0; font-size: 18px; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary span { color: var(--purple); font: 22px var(--mono); }
  details[open] summary span { transform: rotate(45deg); }
  details p { color: var(--muted); font-size: 17px; max-width: 680px; padding-bottom: 10px; }
  footer { border-top: 1px solid var(--line); padding: 28px 0 36px; display: flex; justify-content: space-between; gap: 24px; font: 14px/1.6 var(--mono); color: var(--muted); flex-wrap: wrap; }
  .footer-tagline { margin: 8px 0 0; }
  .organizer { margin: 0; }
  .organizer a { color: var(--pink); }
  .skip { position: absolute; left: 12px; top: -100px; padding: 12px; background: var(--panel); z-index: 2; }
  .skip:focus { top: 12px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  @media(max-width:700px) {
    .page { padding: 0 22px; }
    header { padding: 18px 0; gap: 16px; }
    .header-actions { gap: 16px; }
    h1 { font-size: 48px; letter-spacing: -2px; }
    .intro { font-size: 19px; margin: 20px 0 12px; }
    .attitude { font-size: 18px; }
    h2, .about-grid h2 { font-size: 30px; }
    .about-grid, .find-grid { grid-template-columns: 1fr; gap: 24px; }
    .sticker { width: 190px; margin: 0 0 12px; }
    footer { flex-direction: column; gap: 20px; }
    section:not(.hero) { padding-bottom: 36px; }
  }
  @media(max-width:600px) {
    header { display: grid; grid-template-columns: 1fr auto; row-gap: 18px; }
    .header-actions { display: contents; }
    .brand-link { grid-column: 1; grid-row: 1; }
    header nav { grid-column: 1; grid-row: 2; }
  }
  @media(max-width:370px) {
    h1 { font-size: 42px; }
    .button { gap: 16px; font-size: 15px; padding: 15px 16px; }
  }
  @media(prefers-reduced-motion:reduce) { html { scroll-behavior: auto; } }
</style>
